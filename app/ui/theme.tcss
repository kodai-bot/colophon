/* Colophon — shared theme.
   Loaded first by every mode (CSS_PATH = ["theme.tcss", ...]).
   Mode-specific overrides go in each mode's inline CSS. */

Screen {
    background: #09091f;
    color: #c8b89a;
}

/* ── Header (top bar) ───────────────────────────────────── */

#topbar {
    height: 3;
    background: #1a1a3a;
    border-bottom: solid #2a2a5a;
}

HeaderBar {
    width: 1fr;
    height: 3;
    color: #d4af37;
    text-align: center;
    content-align: center middle;
    text-style: bold;
    padding: 0 2;
}

/* ── Footer + hint bar ──────────────────────────────────── */

FooterBar {
    background: #0f0f2a;
    color: #9898b8;
    border-top: solid #1a1a3a;
    padding: 0 1;
    height: 2;
    content-align: left middle;
    text-style: italic;
}

HintBar {
    background: #0a0a1a;
    color: #9898b8;
    padding: 0 1;
    height: 1;
}

/* ── Buttons ────────────────────────────────────────────── */

Button {
    background: #12123a;
    border: solid #2a2a5a;
    color: #c8b89a;
    min-width: 10;
}

Button:hover {
    background: #1a1a4a;
    border: solid #d4af37;
    color: #d4af37;
}

Button:focus {
    border: solid #d4af37;
    text-style: bold;
}

BackButton {
    width: auto;
    min-width: 14;
    height: 3;
    margin: 0 1;
    background: #1a1a2a;
    border: solid #6a4a1a;
    color: #d4af37;
}

BackButton:hover {
    background: #2a1a0a;
    border: solid #d4af37;
    color: #ffd700;
}

/* ── Inputs ─────────────────────────────────────────────── */

Input {
    background: #0a0a1a;
    border: solid #2a2a5a;
    color: #c8b89a;
}

Input:focus {
    border: solid #d4af37;
}

/* ── Common widgets used across modes ───────────────────── */

ScanDisplay {
    background: #17130a;
    border: solid #4a3f1f;
    padding: 1;
    margin: 1;
}

DailyManifest {
    background: #17130a;
    border: solid #4a3f1f;
    padding: 1;
    margin: 1;
}

NonIsbnPanel {
    background: #0f0f2a;
    border: solid #2a2a5a;
    padding: 1;
    margin: 1;
}

StockAlert {
    color: #ff6b6b;
    padding: 0 1;
    height: 1;
}

StockAlert.alert-visible {
    background: #2a0a0a;
    text-style: bold;
}
